#!/usr/bin/env bash
set -euo pipefail

BASE="/opt/greenbrain-platform"

# shellcheck disable=SC1091
source "$BASE/orchestration/lib/common.sh"

gb_enter_root
export APP_ENV="${APP_ENV:-dev}"

gb_header "GREENBRAIN RUNTIME VALIDATION"
echo "APP_ENV=${APP_ENV}"
echo

bash orchestration/validators/validate_client_runtime.sh

echo
echo "RUNTIME_VALIDATION_DONE"
