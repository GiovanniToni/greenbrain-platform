APP_NAME=GreenBrain Backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=greenbrain
POSTGRES_USER=greenbrain
POSTGRES_PASSWORD=greenbrain

# JWT
JWT_SECRET=CHANGE_ME
JWT_EXPIRE_MINUTES=60

# Supabase — required only for /api/v1/customer-ops (central hub).
# Leave blank to disable that endpoint; all other endpoints work without it.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_BUCKET=ml-snapshots

# Source DB credential encryption
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not reuse JWT_SECRET.
SOURCE_DB_SECRET_KEY=CHANGE_ME_FERNET_KEY

