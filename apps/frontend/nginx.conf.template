server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ── Compression ───────────────────────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # ── Hashed static assets (Vite outputs assets/index-<hash>.js etc.) ───────
    # Safe to cache aggressively; hash changes on every build.
    location ~* ^/assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # ── Other static files ────────────────────────────────────────────────────
    location ~* \.(ico|png|jpg|jpeg|gif|webp|woff2?|ttf|otf|eot)$ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    # ── API proxy — forward /api/* to FastAPI backend ─────────────────────────
    # BACKEND_HOST is substituted at container start via envsubst.
    # Default value: backend:8000 (docker-compose service name).
    location /api/ {
        proxy_pass         http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";

        proxy_read_timeout  120s;
        proxy_send_timeout  120s;
        proxy_connect_timeout 10s;
    }

    # ── SPA fallback — all other routes served from index.html ───────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── Health probe ─────────────────────────────────────────────────────────
    location /nginx-health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
