PG_USER=postgres
PG_PASSWORD=CHANGE_ME
PG_HOST=localhost
PG_PORT=5432
PG_DB=postgres

# Supabase (Storage / Parquet)
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"
SUPABASE_BUCKET="ml-snapshots"

# Parquet
PARQUET_ENABLE=1
PARQUET_DATASET_PREFIX="parquet/features_dense/v1"
PARQUET_CACHE_DIR="/opt/greenbrain/storage/parquet_cache"
