APP_ENV=dev

# --- PostgreSQL (Supabase pooler per dev-cloud, oppure locale) ---
PG_HOST=aws-1-eu-west-1.pooler.supabase.com
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres.CHANGE_ME_PROJECT_REF
PG_PASSWORD=CHANGE_ME
PG_SSLMODE=require

# --- Supabase Storage (ML worker: parquet features + priors) ---
# Richiesto da STORAGE_BACKEND=supabase.
# Lasciare vuoto e impostare STORAGE_BACKEND=local per ambienti client.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://CHANGE_ME_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_BUCKET=ml-snapshots

# --- Parquet cache locale ---
PARQUET_ENABLE=1
PARQUET_DATASET_PREFIX=parquet/features_dense/v1
PARQUET_CACHE_DIR=/opt/greenbrain/storage/parquet_cache

# --- DigitalOcean Spaces (artefatti modelli ML) ---
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=greenbrainmodels
DO_SPACES_KEY=CHANGE_ME
DO_SPACES_SECRET=CHANGE_ME

# --- Path pipeline ML ---
GH_BASE_DIR=/opt/greenbrain-platform
GH_REPO_DIR=/opt/greenbrain-platform/apps/ml-worker
GH_LOG_DIR=/opt/greenbrain-platform/runtime-reports
GH_TMP_DIR=/opt/greenbrain-platform/runtime-reports/tmp

# --- ML pipeline knobs ---
SPACES_PREFIX=models_v4
SPACES_BT_PREFIX=backtests_v4
SPACES_BETA_PREFIX=betas_v4
PREDICT_LIMIT=0
AUTO_TRAIN_MISSING=1
TRAIN_TIMEOUT_SEC=7200
TRAIN_BATCH_SIZE=10
TRAIN_LIMIT=0
FAMIGLIE_COL=famiglia
FAMIGLIE_SOURCE_TABLE=public.famiglie_catalog_static

# --- Compatibility aliases (export_features_dense.py) ---
SUPABASE_KEY=${SUPABASE_SERVICE_ROLE_KEY}
SUPABASE_DB_HOST=${PG_HOST}
SUPABASE_DB_PORT=${PG_PORT}
SUPABASE_DB_NAME=${PG_DB}
SUPABASE_DB_USER=${PG_USER}
SUPABASE_DB_PASSWORD=${PG_PASSWORD}
