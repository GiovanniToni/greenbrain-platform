[Unit]
Description=GreenBrain - Sequential Daily Runtime Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Environment=APP_ENV=dev
Environment=RAW_STABLE_MINUTES=20
Environment=RAW_WAIT_TIMEOUT_MINUTES=180
Environment=RAW_POLL_SECONDS=300
Environment=ENABLE_WEATHER_DAILY_INGEST=1
Environment=WEATHER_FORECAST_DAYS=10
Environment=WEATHER_RECENT_ACTUAL_DAYS=7
Environment=WEATHER_INGEST_CURRENT=1
Environment=WEATHER_LOCATION_CODES=firenze,pistoia,prato,quarrata
Environment=WEATHER_BACKEND_CONTAINER=dev_backend
Environment=WEATHER_REFRESH_FEATURE_STORE=1
Environment=WEATHER_FEATURE_REFRESH_LOOKBACK_DAYS=35
Type=oneshot
User=gh
Group=gh
WorkingDirectory=/opt/greenbrain-platform
ExecStart=/bin/bash -lc '/opt/greenbrain-platform/orchestration/jobs/runtime/run_daily_sequence.sh'
TimeoutStartSec=0
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
