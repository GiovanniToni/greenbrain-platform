APP_ENV=client-local

TENANT_CODE=cliente_reale
TENANT_NAME="Cliente Reale"
TENANT_HOST=cliente-reale.greenbrain.it

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=greenbrain_cliente_reale
POSTGRES_USER=greenbrain_cliente_reale
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_SSLMODE=disable
DATABASE_URL=postgresql://greenbrain_cliente_reale:CHANGE_ME_DB_PASSWORD@postgres:5432/greenbrain_cliente_reale

JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET
JWT_EXPIRE_MINUTES=60

LOCAL_FRONTEND_PORT=8088
LOCAL_BACKEND_PORT=8008

CENTRAL_AUTH_URL=https://www.greenbrain.it
CENTRAL_TENANT_CODE=cliente_reale

REMOTE_ACCESS_MODE=reverse-tunnel
TUNNEL_ENABLED=true
TUNNEL_PROVIDER=CHANGE_ME
TUNNEL_AUTH_TOKEN=CHANGE_ME_TUNNEL_TOKEN
TUNNEL_PUBLIC_HOST=cliente-reale.greenbrain.it
