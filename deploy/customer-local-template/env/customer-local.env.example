APP_ENV=client-local
TENANT_CODE=CHANGE_ME_TENANT
TENANT_NAME=CHANGE_ME_TENANT_NAME
TENANT_HOST=CHANGE_ME.greenbrain.it
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=CHANGE_ME_DB
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_SSLMODE=disable
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@postgres:5432/CHANGE_ME_DB
JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET
JWT_EXPIRE_MINUTES=60
LOCAL_BACKEND_PORT=8008
LOCAL_FRONTEND_PORT=8088
CENTRAL_AUTH_URL=https://www.greenbrain.it
CENTRAL_TENANT_CODE=CHANGE_ME_TENANT
REMOTE_ACCESS_MODE=reverse-tunnel
TUNNEL_ENABLED=true
LOCAL_CUSTOMER_EMAIL=CHANGE_ME_LOCAL_EMAIL
LOCAL_CUSTOMER_FULL_NAME=CHANGE_ME_LOCAL_FULLNAME
LOCAL_CUSTOMER_TEMP_PASSWORD=
LOCAL_CUSTOMER_PASSWORD_HASH=CHANGE_ME_LOCAL_HASH
LOCAL_CUSTOMER_PASSWORD_MODE=cloud_password
LOCAL_CUSTOMER_TENANT_CODE=CHANGE_ME_TENANT
LOCAL_CUSTOMER_HOME_HOST=CHANGE_ME.greenbrain.it
LOCAL_CUSTOMER_HOME_PATH=/dashboard
LOCAL_CUSTOMER_USER_ROLE=customer_admin
