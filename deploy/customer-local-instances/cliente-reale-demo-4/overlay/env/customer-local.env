APP_ENV=client-local

TENANT_CODE=cliente-reale-demo-4
TENANT_NAME=cliente-reale-demo-4
TENANT_HOST=cliente-reale-demo-4.greenbrain.it

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=greenbrain_cliente_reale_demo_4
POSTGRES_USER=greenbrain_cliente_reale_demo_4
POSTGRES_PASSWORD=cliente-reale-demo-4_DB_PASSWORD
POSTGRES_SSLMODE=disable
DATABASE_URL=postgresql://greenbrain_cliente_reale_demo_4:cliente-reale-demo-4_DB_PASSWORD@postgres:5432/greenbrain_cliente_reale_demo_4

JWT_SECRET=cliente-reale-demo-4_LOCAL_JWT_SECRET
JWT_EXPIRE_MINUTES=60

LOCAL_FRONTEND_PORT=8088
LOCAL_BACKEND_PORT=8008

CENTRAL_AUTH_URL=https://www.greenbrain.it
CENTRAL_TENANT_CODE=cliente-reale-demo-4

REMOTE_ACCESS_MODE=reverse-tunnel
TUNNEL_ENABLED=true
TUNNEL_PROVIDER=cloudflared
TUNNEL_AUTH_TOKEN=cliente-reale-demo-4_TUNNEL_TOKEN
TUNNEL_PUBLIC_HOST=cliente-reale-demo-4.greenbrain.it
