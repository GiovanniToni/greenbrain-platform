APP_ENV=client-local

TENANT_CODE=cliente-reale-demo-3
TENANT_NAME=cliente-reale-demo-3
TENANT_HOST=cliente-reale-demo-3.greenbrain.it

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=greenbrain_cliente_reale_demo_3
POSTGRES_USER=greenbrain_cliente_reale_demo_3
POSTGRES_PASSWORD=cliente-reale-demo-3_DB_PASSWORD
POSTGRES_SSLMODE=disable
DATABASE_URL=postgresql://greenbrain_cliente_reale_demo_3:cliente-reale-demo-3_DB_PASSWORD@postgres:5432/greenbrain_cliente_reale_demo_3

JWT_SECRET=cliente-reale-demo-3_LOCAL_JWT_SECRET
JWT_EXPIRE_MINUTES=60

LOCAL_FRONTEND_PORT=8088
LOCAL_BACKEND_PORT=8008

CENTRAL_AUTH_URL=https://www.greenbrain.it
CENTRAL_TENANT_CODE=cliente-reale-demo-3

REMOTE_ACCESS_MODE=reverse-tunnel
TUNNEL_ENABLED=true
TUNNEL_PROVIDER=cloudflared
TUNNEL_AUTH_TOKEN=cliente-reale-demo-3_TUNNEL_TOKEN
TUNNEL_PUBLIC_HOST=cliente-reale-demo-3.greenbrain.it
