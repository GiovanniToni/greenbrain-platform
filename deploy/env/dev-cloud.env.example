# GreenBrain DEV CLOUD
# Source of truth per sviluppo proprietario GreenBrain.
# Deve usare Supabase cloud, NON Postgres locale.
# Non inserire credenziali reali in questo file.

APP_ENV=dev
JWT_SECRET=__SET_IN_RUNTIME__
JWT_EXPIRE_MINUTES=60

# Source DB credential encryption.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not reuse JWT_SECRET. Set real value only in deploy/env/dev-cloud.env.
SOURCE_DB_SECRET_KEY=__SET_IN_RUNTIME__

DATABASE_URL=postgresql://__USER__:__PASSWORD__@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

POSTGRES_HOST=aws-1-eu-west-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_SSLMODE=require

STORAGE_BACKEND=supabase
SUPABASE_URL=__SET_IN_RUNTIME__
SUPABASE_SERVICE_ROLE_KEY=__SET_IN_RUNTIME__

STRIPE_SECRET_KEY=__SET_IN_RUNTIME__
STRIPE_WEBHOOK_SECRET=__SET_IN_RUNTIME__
STRIPE_PRICE_STARTER_MONTHLY=__SET_IN_RUNTIME__
STRIPE_PRICE_PRO_MONTHLY=__SET_IN_RUNTIME__
STRIPE_PRICE_ADVANCED_MONTHLY=__SET_IN_RUNTIME__

WORKERS=1
