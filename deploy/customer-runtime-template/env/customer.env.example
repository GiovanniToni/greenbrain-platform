APP_ENV=client-local
TENANT_CODE=cliente_demo
TENANT_HOST=cliente-demo.greenbrain.it

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=greenbrain_cliente_demo
POSTGRES_USER=greenbrain_cliente_demo
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_SSLMODE=disable

DATABASE_URL=postgresql://greenbrain_cliente_demo:CHANGE_ME_DB_PASSWORD@postgres:5432/greenbrain_cliente_demo

JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET
JWT_EXPIRE_MINUTES=60

SYNC_MODE=cloud_push
CENTRAL_AUTH_URL=https://www.greenbrain.it
CENTRAL_API_URL=https://www.greenbrain.it
