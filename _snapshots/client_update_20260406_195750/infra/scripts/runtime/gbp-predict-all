#!/usr/bin/env bash
set -euo pipefail

cd /opt/greenbrain-platform/apps/ml-worker
source /opt/greenbrain-platform/apps/ml-worker/.venv/bin/activate

export APP_ENV="${APP_ENV:-dev}"
source /opt/greenbrain-platform/infra/scripts/load_env.sh

export RUN_TRIGGER_SOURCE="${RUN_TRIGGER_SOURCE:-shadow_systemd}"
export GIT_SHA="$(cd /opt/greenbrain-platform && git rev-parse --short HEAD 2>/dev/null || true)"

exec bash jobs/run_predict_all.sh
