#!/usr/bin/env bash
set -euo pipefail
cd /opt/greenbrain-platform/apps/ml-worker
source /opt/greenbrain-platform/apps/ml-worker/.venv/bin/activate

# ---- new env loader ----
export APP_ENV="${APP_ENV:-dev}"
source /opt/greenbrain-platform/infra/scripts/load_env.sh

export RUN_TRIGGER_SOURCE="${RUN_TRIGGER_SOURCE:-manual}"
python3 -u -m jobs.sync_local_artifacts
