# GreenBrain Frontend — Client Runtime Environment Template
#
# Copy this file to frontend.env and fill in the values.
# DO NOT commit frontend.env to version control.
#
# This template is for customer-local deployments.
# For dev/master (Supabase), see apps/frontend/.env instead.
#
# Docs: docs/architecture/separation-boundary.md

# ── Backend API ────────────────────────────────────────────────
# URL of the GreenBrain backend API.
# In Docker Compose, use the service name as the hostname only
# for server-side calls. For browser-accessible URLs, use the
# host machine address or domain where the backend is exposed.
VITE_API_BASE_URL=http://127.0.0.1:8001

# ── Supabase (solo dev/master) ─────────────────────────────
# Non usato nel client-runtime.
# Le variabili Supabase restano commentate.
