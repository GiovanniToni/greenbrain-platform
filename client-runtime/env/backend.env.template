# GreenBrain Backend — Client Runtime Environment Template
#
# Copy this file to backend.env and fill in the values.
# DO NOT commit backend.env to version control.
#
# This template is for customer-local PostgreSQL deployments.
# For dev/master (Supabase), see apps/backend/.env instead.
#
# Docs: docs/architecture/separation-boundary.md

# ── Application ────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# ── PostgreSQL (local) ─────────────────────────────────────────
# Service name matches the postgres service in docker-compose.yml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=greenbrain
POSTGRES_USER=greenbrain
POSTGRES_PASSWORD=changeme
POSTGRES_SSLMODE=disable

# ── DATABASE_URL ───────────────────────────────────────────────
# Leave empty or omit entirely when using POSTGRES_* vars above.
# If set, DATABASE_URL takes precedence over all POSTGRES_* vars.
# DATABASE_URL=
