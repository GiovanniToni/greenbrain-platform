#!/usr/bin/env bash
set -euo pipefail

cd /opt/greenbrain-platform/apps/ml-worker
source /opt/greenbrain-platform/apps/ml-worker/.venv/bin/activate
set +H
set -a
set +a

echo "===== ML_MONITOR RUNS RUNNING ====="
psql "$DATABASE_URL" -P pager=off -c "
select
    run_id,
    run_type,
    status,
    trigger_source,
    started_at,
    finished_at,
    summary
from ml_monitor.runs
where status = 'running'
order by started_at;
"

echo
echo "===== ML_MONITOR FAMILY_RUNS RUNNING ====="
psql "$DATABASE_URL" -P pager=off -c "
select
    family_run_id,
    run_id,
    family_name,
    family_slug,
    step,
    status,
    rc,
    error_msg,
    started_at,
    finished_at
from ml_monitor.family_runs
where status = 'running'
order by started_at;
"

echo
echo "===== ML_OPS PIPELINE RUNNING ====="
psql "$DATABASE_URL" -P pager=off -c "
select
    run_id,
    job_type,
    trigger_mode,
    status,
    rows_processed,
    error_message,
    started_at,
    finished_at
from ml_ops.pipeline_run_log_v1
where status = 'running'
order by started_at;
"

echo
echo "===== ML_OPS FAMILY RUNNING ====="
psql "$DATABASE_URL" -P pager=off -c "
select
    family_run_id,
    pipeline_run_id,
    job_type,
    family_name,
    status,
    rows_written,
    artifact_path,
    error_message,
    started_at,
    finished_at
from ml_ops.family_run_log_v1
where status = 'running'
order by started_at;
"

echo
echo "===== ML_MONITOR CHILD RUNNING / PARENT CLOSED ====="
psql "$DATABASE_URL" -P pager=off -c "
select
    fr.family_run_id,
    fr.run_id,
    r.status as parent_status,
    fr.family_name,
    fr.family_slug,
    fr.step,
    fr.status,
    fr.started_at,
    fr.finished_at
from ml_monitor.family_runs fr
join ml_monitor.runs r
  on r.run_id = fr.run_id
where fr.status = 'running'
  and r.status <> 'running'
order by fr.started_at;
"

echo
echo "===== ML_OPS CHILD RUNNING / PARENT CLOSED ====="
psql "$DATABASE_URL" -P pager=off -c "
select
    fr.family_run_id,
    fr.pipeline_run_id,
    pr.status as parent_status,
    fr.family_name,
    fr.job_type,
    fr.status,
    fr.started_at,
    fr.finished_at
from ml_ops.family_run_log_v1 fr
join ml_ops.pipeline_run_log_v1 pr
  on pr.run_id = fr.pipeline_run_id
where fr.status = 'running'
  and pr.status <> 'running'
order by fr.started_at;
"

echo
echo "===== PROCESSI ATTIVI ====="
ps -ef | grep -E 'predict_all.py|train_missing_batches.py|train_all_monitor.py|train_one_safe.sh|train_v4_single_family_tweedie.py|predict_v4_single_family_tweedie.py|refresh_registry.py' | grep -v grep || true

echo
echo "===== REGISTRY HEALTH ====="
psql "$DATABASE_URL" -P pager=off -c "
select
    count(*) as n_total,
    count(*) filter (where has_active_artifact = true) as n_with_artifact,
    count(*) filter (where has_active_artifact = false) as n_without_artifact
from ml_ops.v_registry_health_v1;
"

echo
echo "===== STATE SUMMARY ====="
psql "$DATABASE_URL" -P pager=off -c "
select *
from ml_ops.v_state_summary_v1;
"

echo
echo "===== ULTIME RUN ML_MONITOR NON OK ====="
psql "$DATABASE_URL" -P pager=off -c "
select
    run_id,
    run_type,
    status,
    trigger_source,
    started_at,
    finished_at,
    summary
from ml_monitor.runs
where status <> 'ok'
order by run_id desc
limit 20;
"

echo
echo "===== ULTIME RUN ML_OPS NON SUCCESS ====="
psql "$DATABASE_URL" -P pager=off -c "
select
    run_id,
    job_type,
    trigger_mode,
    status,
    rows_processed,
    error_message,
    started_at,
    finished_at
from ml_ops.pipeline_run_log_v1
where status <> 'success'
order by run_id desc
limit 20;
"
