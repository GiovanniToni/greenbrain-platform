#!/usr/bin/env bash
set -euo pipefail

N="${1:-5}"
J="${2:-2}"

cd /opt/greenbrain-platform/apps/ml-worker
source /opt/greenbrain-platform/apps/ml-worker/.venv/bin/activate
set +H
set -a
set +a

unset TRAIN_ONLY_FAMILY
export TRAIN_LIMIT="$N"
export TRAIN_ALL_JOBS="$J"
export RUN_TRIGGER_SOURCE=manual
export RUN_TYPE=train_all_biweekly_manual

python3 -u -m jobs.train_all_monitor
