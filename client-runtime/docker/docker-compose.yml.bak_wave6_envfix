# GreenBrain Client Runtime — Local Stack
#
# Architecture:
#   greenbrain-platform (dev/master) → Supabase cloud DB + Supabase auth
#   client-runtime (this file)       → local PostgreSQL, no Supabase dependency
#
# Services without a profile (default — Wave 6 ready):
#   postgres   local PostgreSQL instance
#   backend    FastAPI app, connects via POSTGRES_* vars, no Supabase SDK
#
# Services behind the 'wave7-frontend' profile (NOT yet standalone):
#   frontend   requires auth layer migration before running without Supabase
#              see: docs/architecture/separation-boundary.md — gap ①
#
# HOW TO USE:
#   # Default: start only the production-ready services
#   docker-compose -f client-runtime/docker/docker-compose.yml up -d
#
#   # Wave 7+: start everything including the frontend (after auth migration)
#   docker-compose -f client-runtime/docker/docker-compose.yml \
#     --profile wave7-frontend up -d
#
# SETUP (one-time):
#   cp client-runtime/env/backend.env.template  client-runtime/env/backend.env
#   # set POSTGRES_PASSWORD in backend.env
#   cp client-runtime/env/frontend.env.template client-runtime/env/frontend.env
#   # set VITE_API_BASE_URL in frontend.env
#
version: "3.9"

services:

  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    volumes:
      - postgres_data:/var/lib/postgresql/data
    env_file:
      - ../env/backend.env
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-greenbrain}
      POSTGRES_USER: ${POSTGRES_USER:-greenbrain}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-greenbrain} -d ${POSTGRES_DB:-greenbrain}"]
      interval: 10s
      timeout: 5s
      retries: 5

  backend:
    image: python:3.11-slim
    restart: unless-stopped
    working_dir: /app
    volumes:
      - ../../apps/backend:/app
    command: >
      sh -c "pip install -r requirements.txt -q &&
             uvicorn app.main:app --host 0.0.0.0 --port 8000"
    env_file:
      - ../env/backend.env
    ports:
      - "8000:8000"
    depends_on:
      postgres:
        condition: service_healthy

  frontend:
    # Wave 7 — not started by default.
    # Activate with: --profile wave7-frontend
    # Blocked by: auth layer still requires VITE_SUPABASE_URL + VITE_SUPABASE_PUBLISHABLE_KEY
    # Unblocked by: docs/architecture/separation-boundary.md — gap ①
    profiles: [wave7-frontend]
    image: node:20-alpine
    working_dir: /app
    volumes:
      - ../../apps/frontend:/app
    command: sh -c "npm install -q && npm run dev"
    env_file:
      - ../env/frontend.env
    ports:
      - "8080:8080"
    depends_on:
      - backend

volumes:
  postgres_data:
